  line-height: 1.4;
}
.archimate-label.green { color: var(--green-l); background: rgba(42,122,82,.08); }
.archimate-label.amber { color: #e8a060; background: rgba(200,118,42,.08); }
.archimate-value {
  padding: 12px 16px;
  font-size: .86rem;
  color: var(--text);
  line-height: 1.6;
}
.protection-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 14px;
  margin-top: 20px;
}
@media(max-width:700px){ .protection-grid { grid-template-columns:1fr; } }
.prot-card {
  background: var(--ink3);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 18px;
}
.prot-num {
  font-family: var(--f-mono);
  font-size: .68rem;
  color: var(--gold);
  letter-spacing: .1em;
  margin-bottom: 8px;
}
.prot-title { font-size: .9rem; font-weight: 600; color: var(--white); margin-bottom: 6px; }
.prot-body { font-size: .82rem; color: var(--text-muted); line-height: 1.55; }
.mission-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 10px;
  margin-top: 20px;
}
@media(max-width:600px){ .mission-grid { grid-template-columns:1fr; } }
.mission-item {
  background: var(--ink3);
  border-left: 3px solid var(--blue-l);
  padding: 14px 16px;
  border-radius: 0 var(--r) var(--r) 0;
}
.mission-item.gold { border-left-color: var(--gold); }
.mission-key { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dim); margin-bottom: 5px; }
.mission-val { font-size: .88rem; color: var(--text); line-height: 1.55; }
