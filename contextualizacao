.archimate-header {
  background: var(--blue);
  padding: 12px 20px;
  font-size: .8rem;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #fff;
}
.archimate-header.green { background: var(--green); }
.archimate-header.amber { background: var(--amber); }
.archimate-row {
  display: grid;
  grid-template-columns: 160px 1fr;
  border-bottom: 1px solid var(--line);
}
.archimate-row:last-child { border-bottom: none; }
.archimate-label {
  padding: 12px 16px;
  font-size: .78rem;
  font-weight: 600;
  color: var(--blue-xl);
  background: rgba(30,90,158,.08);
